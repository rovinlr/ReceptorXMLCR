<odoo>
    <record id="view_move_form_supplier_xml_import" model="ir.ui.view">
        <field name="name">account.move.form.supplier.xml.import</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_supplier_xml_import_wizard)d"
                        string="Importar XML proveedor"
                        type="action"
                        class="btn-secondary"
                        invisible="move_type not in ('in_invoice', 'in_refund')"/>
                <button name="action_read_supplier_xml_attachment"
                        string="Leer XML adjunto"
                        type="object"
                        class="btn-secondary"
                        invisible="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"/>
            </xpath>
            <xpath expr="//page[@id='other_tab']/group[@id='other_tab_group']" position="inside">
                <group string="Recepción XML CR" name="supplier_xml_info"
                       invisible="move_type not in ('in_invoice', 'in_refund')">
                    <field name="supplier_xml_key" string="Clave"/>
                    <field name="supplier_xml_reference_key"
                           invisible="move_type != 'in_refund'"/>
                    <field name="supplier_xml_hacienda_state"
                           decoration-success="supplier_xml_hacienda_state == 'aceptado'"
                           decoration-danger="supplier_xml_hacienda_state == 'rechazado'"/>
                    <field name="supplier_xml_filename" string="Archivo XML"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
